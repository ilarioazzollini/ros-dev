{
    "name": "RosRollingDev",
    "image": "ros-rolling-dev:latest",
    "privileged": true,
    "runArgs": [
        "--rm",
        "--network=host",
        "--ipc=host"
    ],
    "remoteUser": "root",
    "workspaceMount": "source=${localWorkspaceFolder},target=/root/ros-dev,type=bind",
    "workspaceFolder": "/root/ros-dev",
    "customizations": {
        "vscode": {
            "extensions": [
                "llvm-vs-code-extensions.vscode-clangd",
                "usernamehw.errorlens",
                "vadimcn.vscode-lldb",
                "ms-vscode.cmake-tools"
            ],
            "settings": {
                "clangd.path": "/usr/bin/clangd",
                "clangd.arguments": [
                    "--fallback-style=none",
                    "--background-index",
                    "--query-driver=/usr/bin/g++",
                    "--header-insertion=never",
                    // scripts/build.sh and scripts/clean_build.sh merge every
                    // linked package's per-package compile_commands.json
                    // (colcon writes one per package) into this single file
                    // via scripts/merge_compile_commands.sh, so clangd sees
                    // the whole workspace. Explicit rather than relying on
                    // clangd's upward directory search: build/ is a sibling
                    // of src/, not an ancestor of the source files under it,
                    // so the search would otherwise miss it.
                    "--compile-commands-dir=${workspaceFolder}/ros2_ws/build"
                ]
            }
        }
    }
}